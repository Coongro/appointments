{
  "id": "appointments",
  "version": "0.6.0",
  "apiVersion": "2.0",
  "assets": {
    "styles": ["./dist/assets/tailwind.css", "./dist/assets/fontawesome/css/all.min.css"]
  },
  "contributes": {
    "menus": [
      {
        "path": "Consultas/Agenda",
        "order": 0,
        "icon": "assets/icons/calendar.svg",
        "color": "#6366F1",
        "viewId": "appointments.agenda.open"
      }
    ],
    "views": [
      {
        "id": "appointments.agenda.open",
        "title": "Agenda de Turnos",
        "component": "./dist/views/agenda/index.js",
        "export": "AgendaView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/appointment.repository.js",
        "export": "AppointmentRepository",
        "prefix": "appointments"
      }
    ],
    "settings": {
      "groups": [{ "id": "appointments", "label": "Agenda y turnos", "order": 50 }],
      "pages": [
        {
          "id": "appointments.general",
          "group": "appointments",
          "label": "Horario",
          "icon": "Clock",
          "order": 10
        }
      ],
      "sections": [
        {
          "id": "appointments.general.grid",
          "page": "appointments.general",
          "label": "Horario de la agenda",
          "order": 10,
          "items": [
            {
              "key": "appointments.agenda.startHour",
              "type": "number",
              "label": "Hora de apertura",
              "description": "Primera hora que muestra la agenda del día (0–23).",
              "default": 7,
              "min": 0,
              "max": 23,
              "tags": ["appointments", "agenda", "horario", "apertura"]
            },
            {
              "key": "appointments.agenda.endHour",
              "type": "number",
              "label": "Hora de cierre",
              "description": "Última hora que muestra la agenda del día (1–24).",
              "default": 21,
              "min": 1,
              "max": 24,
              "tags": ["appointments", "agenda", "horario", "cierre"]
            },
            {
              "key": "appointments.agenda.slotMinutes",
              "type": "number",
              "label": "Duración de la franja (min)",
              "description": "Tamaño de cada franja de la agenda, en minutos (ej. 15, 20, 30).",
              "default": 30,
              "min": 5,
              "max": 120,
              "tags": ["appointments", "agenda", "franja", "duración", "slot"]
            }
          ]
        },
        {
          "id": "appointments.general.reminders",
          "page": "appointments.general",
          "label": "Recordatorios",
          "order": 20,
          "items": [
            {
              "key": "appointments.reminders",
              "type": "enum",
              "label": "Recordatorio de turno",
              "description": "Avisar en la campana de Coongro antes de cada turno, para que la clínica lo tenga presente y pueda contactar al tutor. El aviso llega al equipo (no al tutor). Default: sin recordatorio.",
              "default": "off",
              "options": [
                { "value": "off", "label": "Sin recordatorio" },
                { "value": "1", "label": "1 hora antes" },
                { "value": "3", "label": "3 horas antes" },
                { "value": "24", "label": "24 horas antes" }
              ],
              "tags": ["appointments", "reminders", "recordatorio", "turno"]
            }
          ]
        },
        {
          "id": "appointments.general.booking",
          "page": "appointments.general",
          "label": "Reglas de agenda",
          "order": 30,
          "items": [
            {
              "key": "appointments.allowOverlap",
              "type": "boolean",
              "label": "Permitir turnos superpuestos",
              "description": "Si está activado, un mismo profesional puede tener dos turnos en el mismo horario sin avisos. Si lo desactivás, al agendar un turno que se cruza con otro del mismo profesional el sistema pide confirmación antes de guardar (útil para clínicas con un solo consultorio por veterinario). Default: permitido.",
              "default": true,
              "tags": ["appointments", "agenda", "solapamiento", "superposición", "turno"]
            }
          ]
        }
      ]
    }
  }
}
